# Copy this file to .env.local and fill it in.
# .env.local is ignored by git, so your keys stay on your computer.

# --- Database (required) ---------------------------------------------------
# Postgres connection string. The value below matches docker-compose.yml, so
# after `docker compose up -d` in the repo root it works as-is.
# Port 5433 on the host, so it cannot clash with a Postgres already on 5432.
DATABASE_URL=postgresql://zubia:zubia_dev_password@localhost:5433/zubia

# Set to 1 in production, where the database requires TLS. Leave blank for
# the local Docker container, which has no certificate.
DATABASE_SSL=

# Where the site is reachable, e.g. https://zubia.ug (no trailing slash).
# Used to build admin invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Listing photos: Cloudflare R2, or any S3-compatible storage ----------
# Create a bucket at dash.cloudflare.com -> R2, then an API token with
# "Object Read & Write" on it.

# From the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=listing-photos

# The public address photos are served from. Either the bucket's r2.dev URL
# (enable "Public Development URL" on the bucket) or, better for speed and
# for keeping the URLs yours, a custom domain such as https://img.zubia.ug
# Without this, uploads are refused: a stored photo that cannot be shown is
# worse than a clear error.
R2_PUBLIC_BASE_URL=

# Only for non-Cloudflare S3 storage (MinIO, Backblaze, AWS). Leave blank
# for R2 and it is derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_REGION=auto

# --- AI photo enhancement (optional) --------------------------------------
# Every uploaded photo always gets free basic enhancement (straighten, brighten,
# sharpen, compress, remove GPS). AI enhancement on top is optional and PAID
# per photo. Choose: none | gemini | openai
AI_IMAGE_PROVIDER=none

# Gemini: key from https://aistudio.google.com/apikey (needs billing enabled)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# OpenAI (ChatGPT): key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
