# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API Keys.
# .env.local is ignored by git, so your keys stay on your computer.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (starts with sb_publishable_). The older "anon" key also works.
# Safe to show in the browser: database rules protect the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (starts with sb_secret_). The older "service_role" key also works.
# KEEP PRIVATE. Never share it or put NEXT_PUBLIC_ in front of it.
# Only needed for the admin "Add admin" button.
SUPABASE_SECRET_KEY=

# --- AI photo enhancement (optional) ---------------------------------------
# Every uploaded photo always gets free basic enhancement (straighten, brighten,
# sharpen, compress, remove GPS). AI enhancement on top is optional and PAID
# per photo (neither Gemini nor OpenAI image editing had a free API tier in
# Nov 2026). Choose: none | gemini | openai
AI_IMAGE_PROVIDER=none

# Gemini: key from https://aistudio.google.com/apikey (needs billing enabled)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# OpenAI (ChatGPT): key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
